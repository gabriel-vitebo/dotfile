# config-workplace terminal: preferências portáteis aprovadas.
# Pode ser carregado antes ou depois das configurações locais.
# Tema, plugins, aliases e inicialização do Oh My Zsh pertencem ao startup pessoal.
# Não inicializar frameworks aqui: o bloco legado pode preceder o startup local.
[[ -z "${CW_TERMINAL_FRAGMENT_LOADED:-}" ]] || return 0
typeset -g CW_TERMINAL_FRAGMENT_LOADED=1
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if (( ! $+functions[nvm] )) && [[ -s "$NVM_DIR/nvm.sh" ]]; then
    source "$NVM_DIR/nvm.sh"
fi
if [[ -s "$NVM_DIR/bash_completion" ]]; then
    source "$NVM_DIR/bash_completion"
fi
case ":$PATH:" in
    *:"$HOME/.local/bin":*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac
